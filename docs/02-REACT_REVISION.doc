<title>React.js Core & Component Patterns Revision</title>
<style>
  body { font-family: Calibri, 'Segoe UI', Arial, sans-serif; font-size: 11pt; line-height: 1.5; color: #1e293b; margin: 30px; }
  h1 { font-size: 20pt; color: #0284c7; border-bottom: 2px solid #0284c7; padding-bottom: 6px; }
  h2 { font-size: 14pt; color: #0369a1; margin-top: 20px; border-bottom: 1px solid #cbd5e1; padding-bottom: 4px; }
  h3 { font-size: 12pt; color: #0f172a; margin-top: 14px; }
  p, li { margin: 4px 0; }
  .callout { background: #f0f9ff; border-left: 4px solid #0284c7; padding: 10px 14px; margin: 12px 0; border-radius: 4px; }
  .code { font-family: Consolas, 'Courier New', monospace; background: #f1f5f9; padding: 2px 6px; border-radius: 3px; font-size: 10pt; color: #0f172a; }
  pre { background: #0f172a; color: #38bdf8; font-family: Consolas, monospace; padding: 12px; border-radius: 6px; font-size: 10pt; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; margin: 12px 0; }
